# Token expiry configuration for CI.
#
# Update the dates whenever you rotate a token, and keep the matching
# repository secret (Settings -> Secrets and variables -> Actions) in sync.
# Format: YYYY-MM-DD
#
# RELEASE_TOKEN: fine-grained PAT used by the release workflow to create
#   GitHub Releases (Contents + Workflows write). Validity: 1 year.
RELEASE_TOKEN_EXPIRY=2027-07-31
#
# NPM_TOKEN: npm granular token used by the npm distribution workflow
#   (publish access to the @juya-ai-lab scope, bypass 2FA). Validity: 90 days.
NPM_TOKEN_EXPIRY=2026-10-30
